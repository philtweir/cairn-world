{
  "name": "cairn-world",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn campaign world as an Alizarin graph: CSV in, static site out",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "NODE_OPTIONS=--experimental-wasm-modules node src/build.mjs --check",
    "build": "NODE_OPTIONS=--experimental-wasm-modules node src/build.mjs",
    "import-rules": "node src/import-rules.mjs",
    "serve": "python3 -m http.server 8000 --directory dist",
    "set-password": "node src/set-password.mjs"
  },
  "dependencies": {
    "alizarin": "2.0.0-alpha.139",
    "d3-force": "3.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lucide-static": "1.48.0"
  }
}
