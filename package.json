{
  "name": "cairn-world",
  "version": "0.1.0",
  "private": true,
  "description": "Cairn campaign world as an Alizarin graph: CSV in, static site out",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "NODE_OPTIONS=--experimental-wasm-modules node src/build.mjs --check",
    "build": "NODE_OPTIONS=--experimental-wasm-modules node src/build.mjs",
    "import-rules": "node src/import-rules.mjs",
    "merge-edits": "node src/merge-edits.mjs",
    "serve": "python3 -m http.server 8000 --directory dist",
    "set-password": "node src/set-password.mjs",
    "globe": "node src/globe.mjs",
    "terrain": "node src/terrain.mjs"
  },
  "dependencies": {
    "@alizarin/geo": "2.0.0-alpha.139",
    "@duckdb/duckdb-wasm": "1.32.0",
    "alizarin": "2.0.0-alpha.139",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "ros-madair": "0.1.0-alpha.24"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "clipper-lib": "6.4.2",
    "d3-delaunay": "6.0.4",
    "d3-geo-projection": "4.0.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.48.0",
    "pagefind": "1.5.2",
    "pngjs": "7.0.0",
    "polygon-clipping": "0.15.7",
    "sharp": "0.35.5",
    "simplex-noise": "4.0.3",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3",
    "world-atlas": "2.0.2"
  }
}
